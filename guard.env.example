# cpa_guard 的配置文件。安装脚本会把它复制成 /root/cpa-guard/guard.env（只有 root 能读）。
# 规则：
#   - 每行一个 KEY='值'。等号两边不要有空格，值用单引号括起来（特殊符号就不会出问题）。
#   - 说明只能写在单独一行、以 # 开头；不要写在值的后面。
#   - 不用的项保持 ''。

# ===================== 必填 =====================

# CPA 的管理密钥：CPA config.yaml 里 remote-management 下面 secret-key 的【明文】，
# 也就是登录 CPA 网页管理面板时输入的那个密码。
# CPA 启动后可能把 config.yaml 里的 secret-key 改成一串 $2a$ 开头的乱码，那是加密后的，不能用，要问主人要明文。
CPA_MGMT_KEY=''

# ============ 通知：邮件和 Bark 至少填一种 ============

# --- 邮件（SMTP） ---
# SMTP_PASS 填的是邮箱设置里生成的"授权码 / 应用专用密码"，不是邮箱登录密码。
#   QQ 邮箱:  SMTP_HOST='smtp.qq.com'     SMTP_PORT='465'  授权码在 网页版邮箱 → 设置 → 账号 → 开启 SMTP 服务
#   163 邮箱: SMTP_HOST='smtp.163.com'    SMTP_PORT='465'  授权码在 网页版邮箱 → 设置 → POP3/SMTP/IMAP
#   Gmail:    SMTP_HOST='smtp.gmail.com'  SMTP_PORT='465'  Google 账号 → 安全性 → 两步验证 → 应用专用密码
#   Outlook:  SMTP_HOST='smtp-mail.outlook.com'  SMTP_PORT='587'
# SMTP_PORT 只能是 465（SSL）或 587（STARTTLS）。
SMTP_HOST=''
SMTP_PORT='465'
# 发件邮箱地址，例如 '12345@qq.com'
SMTP_USER=''
# 授权码
SMTP_PASS=''
# 收件地址，多个用英文逗号隔开；留空就发给 SMTP_USER 自己
MAIL_TO=''

# --- Bark（iPhone 推送 App）。不用就保持 '' ---
# 例如 'https://api.day.app/你的Bark密钥'
BARK_URL=''

# ============ 下面的一般保持 ''，安装脚本会自动找 ============

# CPA 的 config.yaml 所在目录，例如 '/root/cliproxyapi'
CPA_DIR=''
# CPA 的日志目录（里面有 main.log、error-*.log），例如 '/root/.cli-proxy-api/logs'
LOG_DIR=''
# CPA 地址，默认 'http://127.0.0.1:端口'（端口从 config.yaml 读）
CPA_BASE=''
# 调用 CPA 的客户端密钥，默认用 config.yaml 里 api-keys 的第一个
CPA_API_KEY=''
# 把触发句翻译成中文用的模型，逗号隔开可写多个（前一个不行用下一个）；
# 默认从 deepseek-flash、gemini-3.8-flash-high 里选 CPA 有的
REWRITE_MODEL=''
# 每小时 / 每天最多允许多少次打到谷歌的 429，默认 10 / 24。越小越不容易封号，但找触发句越慢
HOURLY_BUDGET=''
DAILY_BUDGET=''
# 填 '1'：只找触发句、发通知，不改 CPA 的规则
REPORT_ONLY=''
